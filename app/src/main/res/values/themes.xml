<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ChambAYA" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:statusBarColor">@color/surface_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="android:colorBackground">@color/background_light</item>
    </style>

    <style name="Theme.ChambAYA" parent="Base.Theme.ChambAYA" />
    
    <style name="Theme.ChambAYA.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/splash_red</item>
        <item name="android:statusBarColor">@color/splash_red</item>
        <item name="android:navigationBarColor">@color/splash_red</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <!-- Card Styles -->
    <style name="Widget.ChambAYA.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">@color/surface_light</item>
    </style>

    <style name="Widget.ChambAYA.Card.Featured" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">3dp</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="strokeColor">@color/accent_gold</item>
        <item name="cardBackgroundColor">@color/surface_light</item>
    </style>

    <!-- Bottom Navigation Style -->
    <style name="Widget.ChambAYA.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_color_selector</item>
        <item name="itemTextColor">@color/bottom_nav_color_selector</item>
        <item name="itemRippleColor">@color/primary_container</item>
        <item name="elevation">8dp</item>
        <item name="backgroundTint">@color/surface_light</item>
    </style>
</resources>
