<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="32dp"
    app:cardElevation="16dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="36dp"
        android:paddingBottom="30dp">

        <!-- Badge / Icon Container -->
        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp">

            <!-- Scalloped Badge / Icon -->
            <ImageView
                android:id="@+id/ivBadgeIcon"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:contentDescription="Icono de verificación"
                android:src="@drawable/ic_mail_waiting_circle" />

            <!-- Circular Progress Overlay during waiting -->
            <ProgressBar
                android:id="@+id/progressWaiting"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/primary" />
        </FrameLayout>

        <!-- Title (like "Successful" in screenshot) -->
        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-black"
            android:text="Esperando Verificación"
            android:textColor="#18181B"
            android:textSize="22sp"
            android:textAlignment="center" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvDialogSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="3dp"
            android:text="Hemos enviado el enlace a tu correo. Haz clic en él para continuar."
            android:textColor="#71717A"
            android:textSize="13sp"
            android:textAlignment="center" />

        <!-- Email Display Box -->
        <TextView
            android:id="@+id/tvDialogEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill_chip"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:singleLine="true"
            android:text="usuario@gmail.com"
            android:textColor="@color/primary"
            android:textSize="13sp" />

        <!-- Primary Action Button (Matches "Done" button in screenshot) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDoneAction"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="26dp"
            android:fontFamily="sans-serif-bold"
            android:text="Abrir mi Correo"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:backgroundTint="#27272A"
            app:cornerRadius="16dp" />

        <!-- Secondary Buttons Container -->
        <LinearLayout
            android:id="@+id/layoutSecondaryActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResendVerification"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Reenviar correo"
                android:textColor="@color/primary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="•"
                android:textColor="#A1A1AA"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelVerification"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Cancelar"
                android:textColor="#71717A"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
