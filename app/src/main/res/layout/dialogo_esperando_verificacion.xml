<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/surface_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="28dp">

        <!-- Icon Circle -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_guest_icon_circle">

            <TextView
                android:id="@+id/tvDialogIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="📩"
                android:textSize="32sp" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-black"
            android:text="Esperando Verificación..."
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textAlignment="center" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:text="Hemos enviado el enlace de autorización a:"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textAlignment="center" />

        <!-- Email Pill -->
        <TextView
            android:id="@+id/tvDialogEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill_chip"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="usuario@correo.com"
            android:textColor="@color/primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvDialogInstruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif"
            android:text="Abre tu correo en tu celular y haz clic en el enlace. Esta pantalla detectará el permiso automáticamente."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textAlignment="center" />

        <!-- Loading Indicator & Live Status -->
        <LinearLayout
            android:id="@+id/layoutCheckingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/progressChecking"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminateTint="@color/primary" />

            <TextView
                android:id="@+id/tvStatusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="Comprobando en tiempo real..."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Resend Link Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResendVerification"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="¿No te llegó? Reenviar correo"
            android:textColor="@color/primary"
            android:textSize="13sp" />

        <!-- Cancel / Close Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelVerification"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="Cancelar"
            android:textSize="13sp"
            app:cornerRadius="12dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
