<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/welcomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    tools:context=".BienvenidaActivity">

    <LinearLayout
        android:id="@+id/brandGroup"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="34dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_welcome_mark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false"
            android:text="ChambAYA"
            android:textColor="@color/black"
            android:textSize="30sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnLanguage"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/bg_welcome_language"
        android:contentDescription="@string/action_change_language"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_language_globe"
        app:layout_constraintBottom_toBottomOf="@id/brandGroup"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/brandGroup" />

    <ImageView
        android:id="@+id/imgWelcomeIllustration"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/app_name"
        android:layout_marginTop="26dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/welcome_illustration"
        app:layout_constraintBottom_toTopOf="@id/tvWelcomeTitle"
        app:layout_constraintDimensionRatio="0.80"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.38"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/brandGroup"
        app:layout_constraintWidth_percent="0.86" />

    <TextView
        android:id="@+id/tvWelcomeTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/welcome_slide_1_title"
        android:textColor="@color/black"
        android:textSize="31sp"
        app:layout_constraintBottom_toTopOf="@id/tvWelcomeSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgWelcomeIllustration" />

    <TextView
        android:id="@+id/tvWelcomeSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:lineSpacingExtra="7dp"
        android:text="@string/welcome_slide_1_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/indicatorGroup"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvWelcomeTitle" />

    <LinearLayout
        android:id="@+id/indicatorGroup"
        android:layout_width="wrap_content"
        android:layout_height="12dp"
        android:layout_marginTop="22dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/btnAccessAccount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvWelcomeSubtitle">

        <View
            android:id="@+id/indicatorOne"
            android:layout_width="34dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_indicator_active"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/indicatorTwo"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_indicator_inactive"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/indicatorThree"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_indicator_inactive"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/indicatorFour"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_indicator_inactive"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAccessAccount"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginTop="34dp"
        android:layout_marginBottom="76dp"
        android:backgroundTint="@color/splash_red"
        android:elevation="10dp"
        android:fontFamily="sans-serif-medium"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/welcome_get_started"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="17sp"
        app:cornerRadius="36dp"
        app:layout_constraintBottom_toTopOf="@id/signupRow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/indicatorGroup" />

    <LinearLayout
        android:id="@+id/signupRow"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginBottom="38dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvNoAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="@string/auth_no_account"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvSignup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false"
            android:text="@string/auth_signup"
            android:textColor="@color/black"
            android:textSize="16sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
