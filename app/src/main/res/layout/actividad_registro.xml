<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/registerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_red"
    tools:context=".RegistroActivity">

    <!-- Botón de regreso -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Regresar"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_back"
        android:tint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/registerDiagonal"
        android:layout_width="190dp"
        android:layout_height="210dp"
        android:layout_marginEnd="-76dp"
        android:layout_marginBottom="-84dp"
        android:background="@drawable/bg_login_diagonal"
        android:rotation="-26"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Header ChambAYA y Tipo de Cuenta -->
    <LinearLayout
        android:id="@+id/headerGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/registerPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.55">

        <!-- Logo e Icono ChambAYA -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_welcome_mark"
                android:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-black"
                android:text="ChambAYA"
                android:textColor="@color/white"
                android:textSize="34sp" />
        </LinearLayout>

        <!-- Badge Tipo de Registro (Trabajador o Empresa) -->
        <TextView
            android:id="@+id/tvRoleBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_guest_icon_circle"
            android:fontFamily="sans-serif-bold"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:text="@string/register_worker_badge"
            android:textColor="@color/white"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/registerPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_login_panel"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingStart="34dp"
        android:paddingTop="32dp"
        android:paddingEnd="34dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.75"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Título y subtítulo del formulario -->
                <TextView
                    android:id="@+id/tvRegisterTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/register_worker_title"
                    android:textColor="@color/black"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvRegisterSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="14dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/register_worker_subtitle"
                    android:textColor="@color/login_text_secondary"
                    android:textSize="13sp" />

                <!-- Nombre completo / Nombre Empresa -->
                <TextView
                    android:id="@+id/tvFullNameLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:text="@string/register_worker_name_label"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etFullName"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_login_input"
                    android:drawableStart="@drawable/ic_person"
                    android:drawablePadding="14dp"
                    android:fontFamily="sans-serif"
                    android:hint="@string/register_worker_name_hint"
                    android:importantForAutofill="yes"
                    android:inputType="textPersonName|textCapWords"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:singleLine="true"
                    android:textColor="@color/black"
                    android:textColorHint="@color/login_hint"
                    android:textSize="14sp" />

                <!-- Correo Electrónico -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:text="@string/auth_email_label"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_login_input"
                    android:drawableStart="@drawable/ic_login_email"
                    android:drawablePadding="14dp"
                    android:fontFamily="sans-serif"
                    android:hint="@string/auth_email_hint"
                    android:importantForAutofill="yes"
                    android:inputType="textEmailAddress"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:singleLine="true"
                    android:textColor="@color/black"
                    android:textColorHint="@color/login_hint"
                    android:textSize="14sp" />

                <!-- Contraseña -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:text="@string/auth_password_label"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_login_input">

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:drawableStart="@drawable/ic_login_lock"
                        android:drawablePadding="14dp"
                        android:fontFamily="sans-serif"
                        android:hint="@string/auth_password_hint"
                        android:importantForAutofill="yes"
                        android:inputType="textPassword"
                        android:paddingStart="18dp"
                        android:paddingEnd="58dp"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textColorHint="@color/login_hint"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/ivTogglePassword"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="18dp"
                        android:clickable="true"
                        android:contentDescription="@string/auth_show_password"
                        android:focusable="true"
                        android:src="@drawable/ic_login_eye_off" />
                </FrameLayout>

                <!-- Confirmar Contraseña -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:text="@string/auth_confirm_password_label"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_login_input">

                    <EditText
                        android:id="@+id/etConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:drawableStart="@drawable/ic_login_lock"
                        android:drawablePadding="14dp"
                        android:fontFamily="sans-serif"
                        android:hint="@string/auth_confirm_password_hint"
                        android:importantForAutofill="yes"
                        android:inputType="textPassword"
                        android:paddingStart="18dp"
                        android:paddingEnd="58dp"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textColorHint="@color/login_hint"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/ivToggleConfirmPassword"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="18dp"
                        android:clickable="true"
                        android:contentDescription="@string/auth_show_password"
                        android:focusable="true"
                        android:src="@drawable/ic_login_eye_off" />
                </FrameLayout>

                <!-- Términos -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/cbAgreement"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:buttonTint="@color/login_red"
                        android:padding="0dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:text="@string/auth_terms"
                        android:textColor="@color/login_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Botón Crear Cuenta -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateAccount"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/login_red"
                    android:fontFamily="sans-serif-bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/register_worker_btn"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    app:cornerRadius="24dp" />

                <!-- Botón Google -->
                <LinearLayout
                    android:id="@+id/btnGoogleSignIn"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_login_google_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="Google"
                        android:src="@drawable/ic_google_g" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/auth_continue_google"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Fila de login -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/auth_have_account"
                android:textColor="@color/login_text_secondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvBottomSignin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/auth_signin"
                android:textColor="@color/login_red"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
