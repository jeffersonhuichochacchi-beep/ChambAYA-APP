<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_red"
    tools:context=".SplashActivity">

    <LinearLayout
        android:id="@+id/splashCenterGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.46">

        <ImageView
            android:id="@+id/imgSplashLogo"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/splash_logo" />

        <TextView
            android:id="@+id/tvSplashOnline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false"
            android:letterSpacing="0.18"
            android:text="ONLINE"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="36sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSplashBrand"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginBottom="38dp"
        android:background="@drawable/bg_splash_brand"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minWidth="190dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="ChambAYA"
        android:textColor="@color/white"
        android:textSize="26sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
